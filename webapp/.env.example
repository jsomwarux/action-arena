# Action Arena web client environment.
# Copy to webapp/.env and fill in. Every value is read through src/lib/env.ts —
# no other file in webapp/ should touch import.meta.env directly.
#
# These point at the SAME Supabase project as the mobile app; the mobile
# equivalents are the EXPO_PUBLIC_* keys in the repo root .env.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Temporary until the fetch-odds Supabase Edge Function proxy ships. Once it
# does, the browser stops calling The Odds API directly and this key is removed.
VITE_ODDS_API_KEY=

VITE_USE_MOCK_DATA=false
