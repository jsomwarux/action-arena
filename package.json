{
  "name": "action-arena",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "week:align": "node scripts/align-active-nfl-week.mjs",
    "week:kickoff": "node scripts/simulate-week-kickoff.mjs",
    "week:complete": "node scripts/simulate-week-completion.mjs",
    "settle:mock": "node scripts/settle-mock-results.mjs",
    "test:settlement": "supabase db query --linked -f scripts/test-settlement-scenarios.sql",
    "test:simulation-propagation": "supabase db query --linked -f scripts/test-game-simulation-cross-league-propagation.sql",
    "test:global-week": "supabase db query --linked -f scripts/test-global-week-sync-and-simulation.sql",
    "test:weekly-resolution": "supabase db query --linked -f scripts/test-weekly-matchup-resolution.sql",
    "test:season-awards": "supabase db query --linked -f scripts/test-end-of-season-awards.sql",
    "test:profile-stats": "node scripts/test-profile-stats.mjs",
    "test:home-dashboard": "node scripts/test-home-dashboard-data-integrity.mjs",
    "test:leaderboard": "supabase db query --linked -f scripts/test-leaderboard-ranking.sql",
    "test:season-pass": "supabase db query --linked -f scripts/test-season-pass.sql",
    "test:ad-hooks": "node scripts/test-ad-hooks.mjs",
    "test:analytics-events": "node scripts/test-analytics-events.mjs",
    "test:submit-conflicts": "supabase db query --linked -f scripts/test-submit-conflict-validation.sql",
    "test:edge-cases:source": "node scripts/test-edge-cases.mjs",
    "test:edge-cases:db": "supabase db query --linked -f scripts/test-edge-cases.sql",
    "test:edge-cases": "npm run test:edge-cases:source && npm run test:edge-cases:db",
    "test:notifications": "supabase db query --linked -f scripts/test-notification-events.sql",
    "seed:manual-regressions": "supabase db query --linked -f scripts/seed-manual-regression-fixtures.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.104.1",
    "@tanstack/react-query": "^5.100.3",
    "expo": "~54.0.34",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react-test-renderer": "19.1.0",
    "supabase": "^2.95.3",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  },
  "private": true
}
